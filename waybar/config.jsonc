{
    "layer": "top",
    "position": "top",
    "height": 34,
    "spacing": 0,

    "modules-left": [
        "niri/workspaces",
        "niri/window"
    ],

    "modules-center": [
        "niri/language",
        "clock#date",
        "clock#time"
    ],

    "modules-right": [
        "backlight",
        "custom/system",
        "pulseaudio",
        "battery",
        "custom/power"
    ],

    "clock#date": {
        "format": " {:%a, %d %b}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "interval": 3600
    },

    "clock#time": {
        "format": "󰥔 {:%I:%M %p}",
        "interval": 30,
        "tooltip": false
    },

    "niri/language": {
        "format": "󰌌 {}",
        "format-en": "us",
        "format-ru": "ru"
    },

    "niri/workspaces": {
        "format": "{icon}",
        "format-empty": " ",
        "empty-format": " ",
        "tooltip-format": "{name}",
        "on-click-activate": false,
        "on-click-middle": false,
        "hide-empty-workspaces": true,
        "scroll-wrap": true
    },

    "niri/window": {
        "icon": true,
        "icon-size": 13,
        "expand-on-click": false,
        "format": "{title}",
        "tooltip-format": "{title}",
        "rewrite": {
            "Firefox": "Firefox"
        }
    },

    "backlight": {
        "format": "󰃟 {percent}%",
        "tooltip-format": "Brightness: {percent}%",
        "on-click": "brightnessctl set 5%-",
        "on-click-middle": "brightnessctl set 5%+",
        "scroll-up": "brightnessctl set 5%+",
        "scroll-down": "brightnessctl set 5%-"
    },

    "custom/system": {
        "exec": "$HOME/.config/waybar/scripts/waybar-system.sh",
        "interval": 2,
        "return-type": "json",
        "format": "{}",
        "tooltip": true
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰖁 muted",
        "format-icons": {
            "default": [
                "󰕿",
                "󰖀",
                "󰕾"
            ]
        },
        "tooltip-format": "{desc}\nVolume: {volume}%",
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "scroll-up": "wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+",
        "scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"
    },

    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-charging": "󰂄 {capacity}%",
        "format-plugged": "󰚥 {capacity}%",
        "format-full": "󰂅 {capacity}%",
        "format-icons": [
            "󰁺",
            "󰁻",
            "󰁼",
            "󰁽",
            "󰁾",
            "󰁿",
            "󰂀",
            "󰂁",
            "󰂂",
            "󰁹"
        ]
    },

    "custom/power": {
        "format": "󰐥",
        "tooltip": false,
        "on-click": "wlogout"
    }
}
